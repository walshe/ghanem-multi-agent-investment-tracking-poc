{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(./mvnw *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npx *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Edit(/contract/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/agents/**)",
      "Read(./.env)",
      "Bash(git push *)"
    ]
  }
}
